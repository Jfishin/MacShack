 }
 
+// METALGLDRV_OCCLUSION_EARLY_SUBMIT=1: the first draw after a run of occlusion queries sends the work to the GPU, so
+// the result is there for a poll a while later (the next frame, in a game); without it the work waits for a flush.
+TEST(occlusion_early_submit) {
+    static const char* vs = "#version 330 core\nvoid main() { gl_Position = vec4((gl_VertexID & 1) * 4 - 1, (gl_VertexID & 2) * 2 - 1, 0, 1); }\n";
+    static const char* fs = "#version 330 core\nout vec4 c;\nvoid main() { c = vec4(1); }\n";
+    GLuint prog = compileProgram(vs, fs), vao = 0, q = 0;
+    glGenVertexArrays(1, &vao);
+    glBindVertexArray(vao);
+    glUseProgram(prog);
+    glGenQueries(1, &q);
+    for (int early = 0; early < 2; early++) {
+        setenv("METALGLDRV_OCCLUSION_EARLY_SUBMIT", early ? "1" : "0", 1);
+        mglTestEnvChanged();
+        glFinish();
+        glBeginQuery(GL_SAMPLES_PASSED, q);
+        glDrawArrays(GL_TRIANGLES, 0, 3);
+        glEndQuery(GL_SAMPLES_PASSED);
+        glDrawArrays(GL_TRIANGLES, 0, 3);
+        usleep(200 * 1000);
+        GLint avail = -1;
+        glGetQueryObjectiv(q, GL_QUERY_RESULT_AVAILABLE, &avail);
+        CHECK_EQ(avail, early ? 1 : 0);
+        GLuint samples = 0;
+        glGetQueryObjectuiv(q, GL_QUERY_RESULT, &samples);
+        CHECK(samples > 1);
+    }
+    unsetenv("METALGLDRV_OCCLUSION_EARLY_SUBMIT");
+    mglTestEnvChanged();
+    glDeleteQueries(1, &q);
+    glDeleteVertexArrays(1, &vao);
+    glDeleteProgram(prog);
+    CHECK_GL();
+}
