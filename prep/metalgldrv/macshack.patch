 // Wine's pbuffers: render into one, then bind it as a texture in a shared context.
+// METALGLDRV_RELEASE_NONE=1: CGL contexts keep their work when released (GL_KHR_context_flush_control's release
+// behavior none), as an EGL context created with EGL_CONTEXT_RELEASE_BEHAVIOR_NONE_KHR does.
+TEST(cgl_release_none) {
+    EGLRestore restore;
+    CGLPixelFormatObj pix = choose({kCGLPFAAccelerated, kCGLPFADoubleBuffer});
+    CHECK(pix);
+    if (!pix) return;
+    for (int none = 0; none < 2; none++) {
+        if (none) setenv("METALGLDRV_RELEASE_NONE", "1", 1);
+        else unsetenv("METALGLDRV_RELEASE_NONE");
+        CGLContextObj ctx = nullptr;
+        CHECK_EQ(CGLCreateContext(pix, nullptr, &ctx), kCGLNoError);
+        CHECK_EQ(CGLSetCurrentContext(ctx), kCGLNoError);
+        GLint behavior = -1;
+        glGetIntegerv(0x82FB /* GL_CONTEXT_RELEASE_BEHAVIOR */, &behavior);
+        CHECK_EQ(behavior, none ? 0 /* GL_NONE */ : 0x82FC /* GL_CONTEXT_RELEASE_BEHAVIOR_FLUSH */);
+        CGLSetCurrentContext(nullptr);
+        CGLDestroyContext(ctx);
+    }
+    unsetenv("METALGLDRV_RELEASE_NONE");
+    CGLDestroyPixelFormat(pix);
+}
