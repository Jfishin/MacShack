diff --git a/mono/utils/mono-codeman.h b/mono/utils/mono-codeman.h
index fbe2a2f2..f80ea438 100644
--- a/mono/utils/mono-codeman.h
+++ b/mono/utils/mono-codeman.h
@@ -44,5 +44,24 @@ void            mono_code_manager_foreach  (MonoCodeManager *cman, MonoCodeManag
 void mono_codeman_enable_write (void);
 void mono_codeman_disable_write (void);
 
+/*
+ * MacShack dual mapping (iOS has no same-address W^X: a page is executable only while it is never
+ * written, so code lives in one pool with two addresses). Code pointers, PC-relative displacements
+ * and execution all use the RX address the code manager hands out; every store into code goes
+ * through mono_codeman_rw (), the RW alias at a fixed offset. Outside the pool (heap buffers such
+ * as cfg->native_code, or a build with no pool) the address is itself.
+ */
+extern char *mono_codeman_pool_rx;
+extern char *mono_codeman_pool_rx_end;
+extern ptrdiff_t mono_codeman_pool_delta;
+
+static inline void*
+mono_codeman_rw (const void *p)
+{
+	if ((const char*)p >= mono_codeman_pool_rx && (const char*)p < mono_codeman_pool_rx_end)
+		return (char*)p + mono_codeman_pool_delta;
+	return (void*)p;
+}
+
 #endif /* __MONO_CODEMAN_H__ */
 
