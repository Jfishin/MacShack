diff --git a/src/bridge.c b/src/bridge.c
index 85d00a67..04e48585 100644
--- a/src/bridge.c
+++ b/src/bridge.c
@@ -2618,6 +2618,115 @@ static int br_getsectbyname(struct OcerzVM *vm, OcerzCPU *cpu)
     return br_answer(vm, cpu, seg && sect ? br_main_segment_or_section(seg, sect) : 0);
 }
 
+/*
+ * MacShack: an offline libcurl. iOS ships none, and Feral's engine runs an HTTP thread that polls curl_multi_wait /
+ * curl_multi_perform / curl_multi_info_read for the life of the process while the launcher waits on its first requests.
+ * Here every easy handle added to a multi handle is reported finished with CURLE_COULDNT_RESOLVE_HOST at the next
+ * curl_multi_info_read, curl_multi_wait sleeps like the real one would with nothing to do, and everything else succeeds.
+ * ponytail: no network for guests; a real one would sit on NSURLSession.
+ */
+#include <pthread.h>
+typedef struct { pthread_mutex_t lock; uint64_t queue[64]; int n; uint64_t msg[3]; } FakeCurlMulti;   /* msg = CURLMsg */
+
+static int br_curl_zero(struct OcerzVM *vm, OcerzCPU *cpu) { return br_answer(vm, cpu, 0); }
+static int br_curl_easy_init(struct OcerzVM *vm, OcerzCPU *cpu) { return br_answer(vm, cpu, (uint64_t)(uintptr_t)calloc(1, 64)); }
+static int br_curl_easy_getinfo(struct OcerzVM *vm, OcerzCPU *cpu)
+{
+    uint32_t info = (uint32_t)cpu->gpr[OCERZ_RSI];
+    if (cpu->gpr[OCERZ_RDX] && (info & 0xf00000) != 0x500000)   /* every result but curl_socket_t is 8 bytes wide */
+        memset(ocerz_g2h(cpu->gpr[OCERZ_RDX]), 0, 8);
+    return br_answer(vm, cpu, 0);
+}
+static int br_curl_multi_init(struct OcerzVM *vm, OcerzCPU *cpu)
+{
+    FakeCurlMulti *m = calloc(1, sizeof *m);
+    pthread_mutex_init(&m->lock, NULL);
+    return br_answer(vm, cpu, (uint64_t)(uintptr_t)m);
+}
+static int br_curl_multi_add_handle(struct OcerzVM *vm, OcerzCPU *cpu)
+{
+    FakeCurlMulti *m = (FakeCurlMulti *)(uintptr_t)cpu->gpr[OCERZ_RDI];
+    pthread_mutex_lock(&m->lock);
+    if (m->n < 64)
+        m->queue[m->n++] = cpu->gpr[OCERZ_RSI];
+    pthread_mutex_unlock(&m->lock);
+    return br_answer(vm, cpu, 0);
+}
+static int br_curl_multi_remove_handle(struct OcerzVM *vm, OcerzCPU *cpu)
+{
+    FakeCurlMulti *m = (FakeCurlMulti *)(uintptr_t)cpu->gpr[OCERZ_RDI];
+    pthread_mutex_lock(&m->lock);
+    for (int i = 0; i < m->n; i++)
+        if (m->queue[i] == cpu->gpr[OCERZ_RSI]) {
+            memmove(&m->queue[i], &m->queue[i + 1], (size_t)(m->n - i - 1) * sizeof m->queue[0]);
+            m->n--;
+            break;
+        }
+    pthread_mutex_unlock(&m->lock);
+    return br_answer(vm, cpu, 0);
+}
+static int br_curl_multi_perform(struct OcerzVM *vm, OcerzCPU *cpu)
+{
+    if (cpu->gpr[OCERZ_RSI])
+        *(int *)ocerz_g2h(cpu->gpr[OCERZ_RSI]) = 0;   /* running_handles */
+    return br_answer(vm, cpu, 0);
+}
+static int br_curl_multi_wait(struct OcerzVM *vm, OcerzCPU *cpu)
+{
+    FakeCurlMulti *m = (FakeCurlMulti *)(uintptr_t)cpu->gpr[OCERZ_RDI];
+    int timeout = (int)cpu->gpr[OCERZ_RCX];
+    pthread_mutex_lock(&m->lock);
+    int pending = m->n;
+    pthread_mutex_unlock(&m->lock);
+    if (!pending && timeout > 0)
+        usleep((useconds_t)(timeout > 100 ? 100 : timeout) * 1000);
+    if (cpu->gpr[OCERZ_R8])
+        *(int *)ocerz_g2h(cpu->gpr[OCERZ_R8]) = 0;   /* numfds */
+    return br_answer(vm, cpu, 0);
+}
+static int br_curl_multi_info_read(struct OcerzVM *vm, OcerzCPU *cpu)
+{
+    FakeCurlMulti *m = (FakeCurlMulti *)(uintptr_t)cpu->gpr[OCERZ_RDI];
+    uint64_t out = 0;
+    pthread_mutex_lock(&m->lock);
+    if (m->n > 0) {
+        m->msg[0] = 1;                         /* CURLMSG_DONE */
+        m->msg[1] = m->queue[0];               /* easy_handle */
+        m->msg[2] = 6;                         /* data.result: CURLE_COULDNT_RESOLVE_HOST */
+        memmove(&m->queue[0], &m->queue[1], (size_t)(m->n - 1) * sizeof m->queue[0]);
+        m->n--;
+        out = (uint64_t)(uintptr_t)m->msg;
+    }
+    if (cpu->gpr[OCERZ_RSI])
+        *(int *)ocerz_g2h(cpu->gpr[OCERZ_RSI]) = m->n;   /* msgs_in_queue */
+    pthread_mutex_unlock(&m->lock);
+    return br_answer(vm, cpu, out);
+}
+static int br_curl_slist_append(struct OcerzVM *vm, OcerzCPU *cpu)
