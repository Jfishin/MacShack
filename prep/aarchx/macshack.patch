diff --git a/docs/reference.md b/docs/reference.md
index 7464d4e9..04d6b71a 100644
--- a/docs/reference.md
+++ b/docs/reference.md
@@ -104,6 +104,7 @@ bug is in what that switch controls.
 | `OCERZ_NO_JIT_MMX=1` | run MMX instructions in the interpreter |
 | `OCERZ_NO_HIGH8_ARITH=1` | run arithmetic, compares, moves and setcc on ah, ch, dh and bh in the interpreter, in 64-bit code as in 32-bit |
 | `OCERZ_NO_SHIFT_MEM_IMM=1` | run a shift of memory by an immediate (`shr dword [ebp-0x3c], 2`) in the interpreter, in 64-bit code as in 32-bit |
+| `OCERZ_NO_CLSHIFT_DEAD=1` | keep the flags before a shift by cl live when nothing reads the shift's own (they pass through it only at a count of 0), which sends a shld or shrd by cl whose flags are live to the interpreter |
 | `OCERZ_NZCV_GAP=<n>` | hand a compare's flags straight to the setcc, cmov, adc, sbb or jcc reading them only across at most n instructions between (0 to 8, default 8; 3 was the limit before 2026-10-11) |
 | `OCERZ_NO_NZCV_GAP_LOAD=1` | end the window at a load, instead of letting a load sit in it and building the flags again from the compare's record after it |
 | `OCERZ_NO_ADC_CINC=1` | set the carry in a register and add it for an adc or sbb of an immediate whose carry comes straight from a compare, instead of one csinc after at most one add or sub |
diff --git a/include/ocerz/a64emit.h b/include/ocerz/a64emit.h
index ef526689..58e22395 100644
--- a/include/ocerz/a64emit.h
+++ b/include/ocerz/a64emit.h
@@ -25,6 +25,20 @@ typedef struct A64Buf {
     uint32_t sink;
 } A64Buf;
 
+/*
+ * MacShack: the JIT arena may be dual-mapped, as iOS requires: code runs from an
+ * executable mapping that is never writable, and every store into it goes to the
+ * same offset in a writable alias.  Code pointers everywhere are executable-side
+ * addresses; a64_w turns one inside the arena into the address to store through,
+ * and leaves any other buffer (a scratch A64Buf) alone.  wdelta is 0 when single-mapped.
+ */
+extern uintptr_t ocerz_jit_rx_lo, ocerz_jit_rx_len;
+extern intptr_t ocerz_jit_wdelta;
+static inline uint32_t *a64_w(uint32_t *p)
+{
+    return (uintptr_t)p - ocerz_jit_rx_lo < ocerz_jit_rx_len ? (uint32_t *)((char *)p + ocerz_jit_wdelta) : p;
+}
+
 void a64_emit32(A64Buf *b, uint32_t w);
 uint32_t *a64_label(A64Buf *b);
 
