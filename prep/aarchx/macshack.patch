+        return 0;
+    int sz = insn->ops[mi].size;
+    if (sz != 1 && sz != 2 && sz != 4)
+        return 0;
+    switch (insn->op) {
+    case OCERZ_OP_SHL: case OCERZ_OP_SHR: case OCERZ_OP_SAR: case OCERZ_OP_ROL: case OCERZ_OP_ROR:
+    case OCERZ_OP_SETCC:
+        if (mi != 0) return 0;
+        break;
+    case OCERZ_OP_ADC: case OCERZ_OP_SBB:
+        break;
+    case OCERZ_OP_MUL: case OCERZ_OP_IMUL: case OCERZ_OP_DIV: case OCERZ_OP_IDIV:   /* the operand is only read */
+        if (mi != 0 || insn->nops != 1) return 0;
+        break;
+    default:
+        return 0;
