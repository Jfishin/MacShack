diff --git a/src/keymgr.c b/src/keymgr.c
new file mode 100644
index 00000000..18840ca9
--- /dev/null
+++ b/src/keymgr.c
@@ -0,0 +1,105 @@
+/*
+ * MacShack: libkeymgr for hosts without one.  Old GCC-built C++ runtimes (FMOD Ex and
+ * the games linking it, Shovel Knight) register their exception frames through these
+ * process-wide pointers, each guarded by its own recursive lock.  macOS keeps them in
+ * libSystem's libkeymgr; iOS has none, so the libSystem database's fn records find these
+ * through the RTLD_DEFAULT lookup the bridge uses for libSystem.  On a Mac the main
+ * executable is searched first too, so both hosts run the same code.
+ * ponytail: 64 keys, linear search; Apple's defines about a dozen.
+ */
+#include <pthread.h>
+#include <stddef.h>
+
+#define KM_MAX 64
+
+static struct KmEntry {
+    unsigned key;
+    int used;
+    void *ptr;
+    unsigned mode;
+    pthread_mutex_t lock;
+} g_km[KM_MAX];
+static pthread_mutex_t g_km_table = PTHREAD_MUTEX_INITIALIZER;
+
+static struct KmEntry *km_entry(unsigned key)
+{
+    pthread_mutex_lock(&g_km_table);
+    struct KmEntry *free_slot = NULL, *e = NULL;
+    for (int i = 0; i < KM_MAX && !e; i++) {
+        if (g_km[i].used && g_km[i].key == key)
+            e = &g_km[i];
+        else if (!g_km[i].used && !free_slot)
+            free_slot = &g_km[i];
+    }
+    if (!e && free_slot) {
+        pthread_mutexattr_t a;
+        pthread_mutexattr_init(&a);
+        pthread_mutexattr_settype(&a, PTHREAD_MUTEX_RECURSIVE);
+        pthread_mutex_init(&free_slot->lock, &a);
+        pthread_mutexattr_destroy(&a);
+        free_slot->key = key;
+        free_slot->used = 1;
+        e = free_slot;
+    }
+    pthread_mutex_unlock(&g_km_table);
+    return e;
+}
+
+void *_keymgr_get_and_lock_processwide_ptr(unsigned key)
+{
+    struct KmEntry *e = km_entry(key);
+    if (!e)
+        return NULL;
+    pthread_mutex_lock(&e->lock);
+    return e->ptr;
+}
+
+int _keymgr_get_and_lock_processwide_ptr_2(unsigned key, void **result)
+{
+    struct KmEntry *e = km_entry(key);
+    if (!e)
+        return 12; /* ENOMEM */
+    pthread_mutex_lock(&e->lock);
+    if (result)
+        *result = e->ptr;
+    return 0;
+}
+
+int _keymgr_set_and_unlock_processwide_ptr(unsigned key, void *ptr)
+{
+    struct KmEntry *e = km_entry(key);
+    if (!e)
+        return 12;
+    e->ptr = ptr;
+    pthread_mutex_unlock(&e->lock);
+    return 0;
+}
+
+int _keymgr_unlock_processwide_ptr(unsigned key)
+{
+    struct KmEntry *e = km_entry(key);
+    if (!e)
+        return 12;
+    return pthread_mutex_unlock(&e->lock);
+}
+
+int _keymgr_set_lockmode_processwide_ptr(unsigned key, unsigned mode)
+{
+    struct KmEntry *e = km_entry(key);
+    if (!e)
+        return 12;
+    e->mode = mode;
+    return 0;
+}
+
+unsigned _keymgr_get_lockmode_processwide_ptr(unsigned key)
+{
+    struct KmEntry *e = km_entry(key);
+    return e ? e->mode : 0;
+}
+
+int _keymgr_get_lock_count_processwide_ptr(unsigned key)
+{
+    (void)key;
+    return 0;
+}
