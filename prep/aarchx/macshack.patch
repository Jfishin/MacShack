diff --git a/tests/m32/frontprocess.m b/tests/m32/frontprocess.m
new file mode 100644
index 00000000..5b744195
--- /dev/null
+++ b/tests/m32/frontprocess.m
@@ -0,0 +1,32 @@
+// A game that brings itself to the front as Left 4 Dead 2's launcher does from the script Steam runs: TransformProcessType
+// and SetFrontProcess on kCurrentProcess before its NSApplication exists.  Today's cooperative activation ignores that
+// while another app is in front, so the game ran unfocused (throttled, without the mouse) until the user switched away
+// and back.  The app must now be asked to activate once its event loop turns, once per request; whether the window
+// server then grants it depends on what is in front, so the request is what is counted.  Expected written by hand.
+#import <AppKit/AppKit.h>
+#import <ApplicationServices/ApplicationServices.h>
+#import <objc/message.h>
+
+static int asked;
+@interface App : NSApplication @end
+@implementation App - (void)activateIgnoringOtherApps:(BOOL)flag { asked++; [super activateIgnoringOtherApps:flag]; } @end
+
+int main(void)
+{
+    NSAutoreleasePool *pool = [[NSAutoreleasePool alloc] init];
+    ProcessSerialNumber psn = { 0, kCurrentProcess }, other = { 0, 12345 };
+    TransformProcessType(&psn, kProcessTransformToForegroundApplication);
+    SetFrontProcess(&psn);
+    SetFrontProcess(&other);   /* another process: no request for this one */
+    [App sharedApplication];
+    for (int i = 0; i < 50; i++) {
+        NSEvent *e = ((NSEvent * (*)(id, SEL, NSUInteger, id, id, BOOL))objc_msgSend)(   /* a 4-byte mask, as the game */
+            NSApp, @selector(nextEventMatchingMask:untilDate:inMode:dequeue:), 0xffffffffu,
+            [NSDate dateWithTimeIntervalSinceNow:0.01], NSDefaultRunLoopMode, YES);
+        if (e)
+            [NSApp sendEvent:e];
+    }
+    printf("asked %d\n", asked);
+    [pool drain];
+    return 0;
+}
diff --git a/tests/m32/fsfork.c b/tests/m32/fsfork.c
new file mode 100644
index 00000000..1c1ca51e
--- /dev/null
+++ b/tests/m32/fsfork.c
@@ -0,0 +1,70 @@
+/* The Carbon File Manager as MW3 uses it: FSOpenFork's 16-bit fork number (32-bit on the host; the guard beside it
+ * must survive), PBReadForkAsync with a completion routine (the i386 parameter block; the completion runs on another
+ * thread), FSGetCatalogInfoBulk over a folder (i386 FSCatalogInfo records). fsfork.expected is the x86_64 build's
+ * output under Rosetta. */
+#include <CoreServices/CoreServices.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static volatile int completed;
+static void done(ParmBlkPtr pb) { (void)pb; completed++; }
+
+int main(void)
+{
+    char dir[] = "/tmp/m32fsforkXXXXXX", path[256];
+    mkdtemp(dir);
+    const char *names[] = { "a.ff", "b.ff", "c.iwd" };
+    for (int i = 0; i < 3; i++) {
+        snprintf(path, sizeof path, "%s/%s", dir, names[i]);
+        FILE *f = fopen(path, "w");
+        for (int k = 0; k < 1000 * (i + 1); k++)
+            fputc('a' + k % 26, f);
+        fclose(f);
+    }
+    snprintf(path, sizeof path, "%s/b.ff", dir);
+    FSRef ref;
+    HFSUniStr255 fork;
+    FSGetDataForkName(&fork);
+    struct { FSIORefNum num; short guard; } open = { 0, 0x1234 };
+    OSErr e = FSPathMakeRef((const UInt8 *)path, &ref, NULL);
+    e |= FSOpenFork(&ref, fork.length, fork.unicode, fsRdPerm, &open.num);
+    printf("open %d guard %#x\n", e, (unsigned short)open.guard);
+    char buf[64] = { 0 };
+    FSForkIOParam pb;
+    memset(&pb, 0, sizeof pb);
+    pb.ioCompletion = NewIOCompletionUPP(done);
+    pb.forkRefNum = open.num;
+    pb.buffer = buf;
+    pb.requestCount = 10;
+    pb.positionMode = fsFromStart;
+    pb.positionOffset = 1990;
+    PBReadForkAsync(&pb);
+    for (int i = 0; i < 500 && (pb.ioResult > 0 || !completed); i++)
+        usleep(2000);
+    printf("read %d actual %u [%s] completed %d\n", pb.ioResult, (unsigned)pb.actualCount, buf, completed);
+    FSCloseFork(open.num);
+    FSRef dref;
+    FSIterator it;
+    FSPathMakeRef((const UInt8 *)dir, &dref, NULL);
+    FSOpenIterator(&dref, kFSIterateFlat, &it);
+    FSCatalogInfo info[8];
+    ItemCount n = 0;
+    Boolean changed = 0;
+    e = FSGetCatalogInfoBulk(it, 8, &n, &changed, kFSCatInfoDataSizes | kFSCatInfoNodeFlags, info, NULL, NULL, NULL);
+    unsigned long long total = 0;
+    int files = 0;
+    for (ItemCount i = 0; i < n; i++) {
+        total += info[i].dataLogicalSize;
+        files += !(info[i].nodeFlags & kFSNodeIsDirectoryMask);
+    }
+    printf("bulk %d count %lu files %d bytes %llu\n", e == errFSNoMoreItems ? 0 : e, (unsigned long)n, files, total);
+    FSCloseIterator(it);
+    for (int i = 0; i < 3; i++) {
+        snprintf(path, sizeof path, "%s/%s", dir, names[i]);
+        unlink(path);
+    }
+    rmdir(dir);
+    return 0;
+}
