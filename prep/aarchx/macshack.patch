+static int emit_aborts(int store, int size, uint32_t off)
+{
+    pid_t pid = fork();
+    if (pid == 0) {
+        uint32_t words[4];
+        A64Buf b = { .start = words, .p = words, .end = words + 4, .overflow = 0, .sink = 0 };
+        if (store) a64_str(&b, size, 1, 0, off); else a64_ldr(&b, size, 1, 0, off);
+        _exit(0);
+    }
+    int st = 0;
+    waitpid(pid, &st, 0);
+    return WIFSIGNALED(st) && WTERMSIG(st) == SIGABRT;
+}
