+                m32_rd(ga), m32_rd(gs), depth, kr, m32_rd((uint32_t)cpu->gpr[OCERZ_RSP]));
+    if (kr == KERN_SUCCESS) {
+        m32_wr(gd, depth);
+        m32_wr(gcnt, cnt);
+    }
