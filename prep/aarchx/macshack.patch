+static int br_getsectbyname(struct OcerzVM *vm, OcerzCPU *cpu)
+{
+    const char *seg = (const char *)ocerz_g2h(cpu->gpr[OCERZ_RDI]);
+    const char *sect = (const char *)ocerz_g2h(cpu->gpr[OCERZ_RSI]);
