+/*
+ * MacShack: a dual-mapped arena, iOS's only way to run generated code: an
+ * executable mapping that is never writable plus a writable alias at a fixed
+ * offset (a64_w).  OCERZ_JIT_POOL="<rx>,<rw>,<size>" (hex) is one the host made
+ * (MacShack's debugger-allocated pool); OCERZ_JIT_POOL_MB=<n> builds one here,
+ * which macOS allows an unhardened process, so a store that misses the alias
+ * faults on the Mac as it would on the phone.  NULL: neither asked for.
+ */
+static void *jit_dual_map(size_t *bytes)
+{
+    uintptr_t rx = 0, rw = 0, size = 0;
+    const char *e = getenv("OCERZ_JIT_POOL");
+    if (e && sscanf(e, "%lx,%lx,%lx", &rx, &rw, &size) != 3)
+        rx = 0;
+    e = getenv("OCERZ_JIT_POOL_MB");
+    if (!rx && e && (size = strtoul(e, NULL, 0) << 20)) {
+        if (getenv("OCERZ_JIT_CODE_KB") || getenv("OCERZ_JIT_CODE_MB"))
+            size = *bytes; /* a test asked for this arena size */
+        void *m = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+        mach_vm_address_t alias = 0;
+        vm_prot_t cur, max;
+        if (m != MAP_FAILED &&
+            mach_vm_remap(mach_task_self(), &alias, size, 0, VM_FLAGS_ANYWHERE, mach_task_self(),
+                          (mach_vm_address_t)(uintptr_t)m, FALSE, &cur, &max, VM_INHERIT_NONE) == KERN_SUCCESS &&
+            mprotect(m, size, PROT_READ | PROT_EXEC) == 0) {
+            rx = (uintptr_t)m;
+            rw = (uintptr_t)alias;
+        } else {
+            OCERZ_LOG("OCERZ_JIT_POOL_MB: dual mapping failed\n");
+        }
+    }
+    if (!rx || !rw || !size)
+        return NULL;
+    ocerz_jit_rx_lo = rx;
+    ocerz_jit_rx_len = size;
+    ocerz_jit_wdelta = (intptr_t)(rw - rx);
+    *bytes = size;
+    OCERZ_LOG("JIT arena dual-mapped: rx %#lx rw %#lx size %#lx\n", rx, rw, size);
+    return (void *)rx;
+}
