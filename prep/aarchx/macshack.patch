+static int m32_mem_rewrite_ok(const X86Insn *insn, int *mi_out)
+{
+    static int off = -1;
+    if (off < 0) off = getenv("OCERZ_NO_M32_MEMRW") ? 1 : 0;
+    if (off || !insn->mode32 || insn->addrsize != 4)
+        return 0;
+    int mi = -1;
+    for (int i = 0; i < insn->nops; i++)
