+/* MacShack: compiler-rt's 128-bit division (Subnautica's Unity 2019 imports __udivti3).  API databases cannot
+ * describe __int128 arguments, so these read the register pairs themselves: a in rdi:rsi, b in rdx:rcx, the
+ * result back in rax:rdx.  Division by zero traps in x86 code but is undefined here; it answers 0. */
+static int br_ti3(struct OcerzVM *vm, OcerzCPU *cpu, int op)
+{
+    unsigned __int128 a = ((unsigned __int128)cpu->gpr[OCERZ_RSI] << 64) | cpu->gpr[OCERZ_RDI];
+    unsigned __int128 b = ((unsigned __int128)cpu->gpr[OCERZ_RCX] << 64) | cpu->gpr[OCERZ_RDX];
+    unsigned __int128 r = 0;
+    if (b) switch (op) {
+    case 0: r = a / b; break;
+    case 1: r = a % b; break;
+    case 2: r = (unsigned __int128)((__int128)a / (__int128)b); break;
+    case 3: r = (unsigned __int128)((__int128)a % (__int128)b); break;
+    case 4: {   /* __udivmodti4(a, b, rem) */
+        uint64_t rem = cpu->gpr[OCERZ_R8];
+        r = a / b;
+        if (rem) { unsigned __int128 m = a % b; ocerz_st(rem, 8, (uint64_t)m); ocerz_st(rem + 8, 8, (uint64_t)(m >> 64)); }
+        break;
+    }
+    }
+    cpu->gpr[OCERZ_RDX] = (uint64_t)(r >> 64);
+    return br_answer(vm, cpu, (uint64_t)r);
