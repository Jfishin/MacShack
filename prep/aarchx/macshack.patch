+/*
+ * MacShack: an x86 guest sizes thread stacks in 4 KB pages, and arm64 hosts with 16 KB pages refuse a size that is
+ * not a multiple of theirs with EINVAL (FMOD Studio's 72 KB mixer thread on the iPhone: Studio::System::initialize
+ * failed with ERR_INTERNAL).  The guest asked for at least this much: round up to the host page.
+ */
+int ocerz_sys_pthread_attr_setstacksize(struct OcerzVM *vm, OcerzCPU *cpu)
+{
+    size_t size = (size_t)sb_arg(cpu, 1), page = (size_t)getpagesize();
+    size = (size + page - 1) & ~(page - 1);
+    struct OcerzBridgeFrame outer;
+    ocerz_bridge_raise(&outer, SB_LIB, "_pthread_attr_setstacksize", "i(pL)", (const void *)pthread_attr_setstacksize);
+    int rc = pthread_attr_setstacksize((pthread_attr_t *)sb_ptr(sb_arg(cpu, 0)), size);
+    ocerz_bridge_lower(&outer);
+    return sb_ret(vm, cpu, rc);
+}
