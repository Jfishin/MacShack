diff --git a/tests/run_m32_tests.sh b/tests/run_m32_tests.sh
new file mode 100644
index 0000000..637d530
--- /dev/null
+++ b/tests/run_m32_tests.sh
@@ -0,0 +1,14 @@
+#!/bin/bash
+# MacShack: the i386 (m32) gate. Every tests/m32/<name>.expected is the program's stdout plus a final
+# "exit <status>" line. Names on the command line run just those programs.
+set -uo pipefail
+cd "$(dirname "$0")/.."
+bash tests/m32/build.sh || { echo "FAIL build"; exit 1; }
+names=("$@"); [ ${#names[@]} -gt 0 ] || names=($(cd tests/m32 && ls *.expected | sed 's/\.expected$//'))
+fail=0
+for n in "${names[@]}"; do
+  out=$(cd tests/m32/bin && perl -e "alarm 60; exec @ARGV" ../../../ocerz -native "./$n" 2>"/tmp/m32-$n.err"; echo "exit $?")
+  if [ "$out" == "$(cat tests/m32/$n.expected)" ]; then echo "PASS $n"
+  else echo "FAIL $n"; diff <(echo "$out") tests/m32/$n.expected | head -20; tail -5 "/tmp/m32-$n.err"; fail=1; fi
+done
+exit $fail
diff --git a/tests/unit/test_canon.c b/tests/unit/test_canon.c
new file mode 100644
index 0000000..5db483d
--- /dev/null
+++ b/tests/unit/test_canon.c
@@ -0,0 +1,55 @@
+/*
+ * MacShack: a framework path canonicalized on an iOS-style layout.
+ *
+ * iOS keeps CoreFoundation.framework and friends as flat directories: no
+ * Versions/ symlinks, and no binary on disk (it lives in the shared cache).
+ * realpath of the directory therefore succeeds and hands back the unversioned
+ * name, which no synthesized stub carries, so a guest dlopen of
+ * ".../CoreFoundation.framework/CoreFoundation" failed (Cuphead's Rewired).
+ * A temporary API database names Fake.framework/Versions/A/Fake next to a flat
+ * Fake.framework directory; the unversioned path must come back as that name.
+ * So must Umbrella.framework/Frameworks/Fake.framework/Fake, the old place of a
+ * sub-framework macOS moved to the top level and left a symlink for (Rewired
+ * imports ApplicationServices.framework/Frameworks/CoreText.framework/CoreText).
+ */
+#include "ocerz/dyld.h"
+
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+int main(void)
+{
+    const char *tmp = getenv("TMPDIR");
+    char root[PATH_MAX], path[PATH_MAX], name[PATH_MAX], file[PATH_MAX], out[PATH_MAX];
+    snprintf(root, sizeof root, "%s/ocerz-canon-XXXXXX", tmp && tmp[0] ? tmp : "/tmp");
+    if (!mkdtemp(root))
+        return perror("mkdtemp"), 1;
+    snprintf(path, sizeof path, "%s/macos", root);
+    mkdir(path, 0755);
+    snprintf(path, sizeof path, "%s/macos/27.0", root);
+    mkdir(path, 0755);
+    snprintf(path, sizeof path, "%s/Fake.framework", root);
+    mkdir(path, 0755);
+    snprintf(name, sizeof name, "%s/Fake.framework/Versions/A/Fake", root);
+    snprintf(file, sizeof file, "%s/macos/27.0/Fake.api", root);
+    FILE *f = fopen(file, "w");
+    if (!f)
+        return perror(file), 1;
+    fprintf(f, "ocerz-apidb 1\nlibrary %s\nsdk macos 27\n", name);
+    fclose(f);
+    setenv("OCERZ_APIDB", root, 1);
+
+    for (int i = 0; i < 2; i++) {
+        snprintf(path, sizeof path, i ? "%s/Umbrella.framework/Frameworks/Fake.framework/Fake" : "%s/Fake.framework/Fake", root);
+        if (!ocerz_canon_dylib_path(path, out, sizeof out) || strcmp(out, name) != 0) {
+            fprintf(stderr, "FAIL: %s -> %s, want %s\n", path, out, name);
+            return 1;
+        }
+    }
+    printf("canon ok\n");
+    return 0;
+}
