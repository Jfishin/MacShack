+    int r = select((int)m32_arg(cpu, 0), m32_host(m32_arg(cpu, 1)), m32_host(m32_arg(cpu, 2)), m32_host(m32_arg(cpu, 3)), tp);
+    if (t) {
+        m32_wr(t, (uint32_t)tv.tv_sec);
+        m32_wr(t + 4, (uint32_t)tv.tv_usec);
+    }
+    RETV(r);
+}
