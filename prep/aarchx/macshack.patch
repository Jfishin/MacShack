+    case OCERZ_OP_TEST: case OCERZ_OP_CMP: case OCERZ_OP_AND: case OCERZ_OP_OR: case OCERZ_OP_XOR:
+    case OCERZ_OP_ADD: case OCERZ_OP_SUB: case OCERZ_OP_ADC: case OCERZ_OP_SBB:
+    case OCERZ_OP_INC: case OCERZ_OP_DEC: case OCERZ_OP_NOT: case OCERZ_OP_NEG:
+    case OCERZ_OP_SETCC: case OCERZ_OP_SHL: case OCERZ_OP_SHR: case OCERZ_OP_SAR:
