+++ b/src/m32_gl.c
@@ -103,6 +103,155 @@ static uint32_t bound(unsigned target)
     return (uint32_t)b;
 }
 
+/* GL arguments that are a pointer, or an offset into the buffer bound to their target while one is: the offset goes to
+ * GL as it is.  As a window address it reached GL as a huge offset: glTexImage2D from an unpack buffer failed, and
+ * iOS's GL read Batman's indices at the element buffer's storage plus the window address (a fault that took the
+ * game's thread).  Argument numbers are 0-based. */
+static const struct { const char *name; uint8_t arg; uint16_t target; } g_offsets[] = {
+    { "_glDrawElements", 3, 0x8893 }, { "_glDrawElementsBaseVertex", 3, 0x8893 }, { "_glDrawRangeElements", 5, 0x8893 },
+    { "_glDrawRangeElementsEXT", 5, 0x8893 }, { "_glDrawRangeElementsBaseVertex", 5, 0x8893 },
+    { "_glDrawElementsInstanced", 3, 0x8893 }, { "_glDrawElementsInstancedARB", 3, 0x8893 },
+    { "_glDrawElementsInstancedEXT", 3, 0x8893 }, { "_glDrawElementsInstancedBaseVertex", 3, 0x8893 },
+    { "_glVertexAttribPointer", 5, 0x8892 }, { "_glVertexAttribPointerARB", 5, 0x8892 },
+    { "_glVertexAttribIPointer", 4, 0x8892 }, { "_glVertexAttribIPointerEXT", 4, 0x8892 },
+    { "_glVertexPointer", 3, 0x8892 }, { "_glNormalPointer", 2, 0x8892 }, { "_glColorPointer", 3, 0x8892 },
+    { "_glTexCoordPointer", 3, 0x8892 }, { "_glSecondaryColorPointer", 3, 0x8892 },
+    { "_glSecondaryColorPointerEXT", 3, 0x8892 }, { "_glFogCoordPointer", 2, 0x8892 }, { "_glFogCoordPointerEXT", 2, 0x8892 },
+    { "_glTexImage1D", 7, 0x88EC }, { "_glTexImage2D", 8, 0x88EC }, { "_glTexImage3D", 9, 0x88EC },
+    { "_glTexSubImage1D", 6, 0x88EC }, { "_glTexSubImage2D", 8, 0x88EC }, { "_glTexSubImage3D", 10, 0x88EC },
+    { "_glCompressedTexImage1D", 6, 0x88EC }, { "_glCompressedTexImage2D", 7, 0x88EC },
+    { "_glCompressedTexImage3D", 8, 0x88EC }, { "_glCompressedTexSubImage1D", 6, 0x88EC },
+    { "_glCompressedTexSubImage2D", 8, 0x88EC }, { "_glCompressedTexSubImage3D", 10, 0x88EC },
+    { "_glReadPixels", 6, 0x88EB }, { "_glGetTexImage", 4, 0x88EB }, { "_glGetCompressedTexImage", 2, 0x88EB },
+};
+unsigned m32_gl_offset_target(const char *name, int arg)
+{
+    for (size_t i = 0; i < sizeof g_offsets / sizeof *g_offsets; i++)
+        if (g_offsets[i].arg == arg && !strcmp(g_offsets[i].name, name))
+            return g_offsets[i].target;
+    return 0;
+}
+/* Buffer bindings by context. Asking GL on every draw (m32_gl_buffer_bound) cost Batman about 1.5 ms a frame on Apple's
+ * GL, which answers state queries slowly; the guest's own bind calls (m32_gl_wrap) keep this record instead, and GL is
+ * asked only when it lost track: a context not seen yet, a vertex array object bound (it holds the element binding),
+ * buffers deleted, client state popped, and every new frame (CGLFlushDrawable), which also covers a destroyed context's
+ * address being reused. A context is current on one thread at a time, so its record needs no lock. */
+typedef struct { void *ctx; uint32_t known; uint32_t buf[6]; } Bindings;
+static Bindings g_bindings[32];
+
+static int bind_slot(unsigned target)
+{
+    switch (target) {
+    case 0x8892: return 0;   /* GL_ARRAY_BUFFER */
+    case 0x8893: return 1;   /* GL_ELEMENT_ARRAY_BUFFER */
+    case 0x88EB: return 2;   /* GL_PIXEL_PACK_BUFFER */
+    case 0x88EC: return 3;   /* GL_PIXEL_UNPACK_BUFFER */
+    case 0x8A11: return 4;   /* GL_UNIFORM_BUFFER */
+    case 0x8C8E: return 5;   /* GL_TRANSFORM_FEEDBACK_BUFFER */
+    default: return -1;
+    }
+}
+
+/* the current context's record, made on first use; NULL without a context or room (then GL is asked) */
+static Bindings *bindings(void)
+{
+    gl_init();
+    void *ctx = gl.current ? gl.current() : NULL;
+    if (!ctx)
+        return NULL;
+    for (int i = 0; i < 32; i++)
+        if (__atomic_load_n(&g_bindings[i].ctx, __ATOMIC_ACQUIRE) == ctx)
+            return &g_bindings[i];
+    Bindings *b = NULL;
+    pthread_mutex_lock(&g_lock);
+    for (int i = 0; i < 32 && !b; i++)
+        if (g_bindings[i].ctx == ctx || !g_bindings[i].ctx)
+            b = &g_bindings[i];
+    if (b && b->ctx != ctx) {
+        b->known = 0;
+        __atomic_store_n(&b->ctx, ctx, __ATOMIC_RELEASE);
+    }
+    pthread_mutex_unlock(&g_lock);
+    return b;
+}
+
+static void note(unsigned target, uint32_t buffer)
