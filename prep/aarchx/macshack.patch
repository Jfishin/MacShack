+/*
+ * MacShack: CFCalendarDecomposeAbsoluteTime / ComposeAbsoluteTime are variadic, so they cannot cross by signature.
+ * Reimplemented on CFGregorianDate in the calendar's time zone: the component letters y M d H m s are honoured (the
+ * other letters read 0), as the pointers or values that follow come from the x86-64 argument registers and stack.
+ */
+typedef struct { int32_t year; int8_t month, day, hour, minute; double second; } BrGregorianDate;
+static uint64_t br_int_arg(const OcerzCPU *cpu, int k)
+{
+    static const int regs[6] = { OCERZ_RDI, OCERZ_RSI, OCERZ_RDX, OCERZ_RCX, OCERZ_R8, OCERZ_R9 };
+    return k < 6 ? cpu->gpr[regs[k]] : ocerz_ld(cpu->gpr[OCERZ_RSP] + 8 + (uint64_t)(k - 6) * 8, 8);
+}
+static const void *br_calendar_zone(uint64_t cal)
+{
+    const void *(*copy)(const void *) = dlsym(RTLD_DEFAULT, "CFCalendarCopyTimeZone");
+    return cal && copy ? copy((const void *)(uintptr_t)cal) : NULL;
+}
+static int br_CFCalendarDecomposeAbsoluteTime(struct OcerzVM *vm, OcerzCPU *cpu)
+{
+    BrGregorianDate (*greg)(double, const void *) = dlsym(RTLD_DEFAULT, "CFAbsoluteTimeGetGregorianDate");
+    double at; memcpy(&at, &cpu->xmm[0], sizeof at);
+    const char *desc = (const char *)ocerz_g2h(br_int_arg(cpu, 1));
+    if (!greg || !desc)
+        return br_answer(vm, cpu, 0);
+    BrGregorianDate g = greg(at, br_calendar_zone(br_int_arg(cpu, 0)));
+    int k = 2;
+    for (const char *c = desc; *c; c++) {
+        int v = *c == 'y' ? g.year : *c == 'M' ? g.month : *c == 'd' ? g.day : *c == 'H' ? g.hour : *c == 'm' ? g.minute : *c == 's' ? (int)g.second : 0;
+        uint64_t out = br_int_arg(cpu, k++);
+        if (out)
+            *(int32_t *)ocerz_g2h(out) = v;
+    }
+    return br_answer(vm, cpu, 1);
+}
+static int br_CFCalendarComposeAbsoluteTime(struct OcerzVM *vm, OcerzCPU *cpu)
+{
+    double (*to_abs)(BrGregorianDate, const void *) = dlsym(RTLD_DEFAULT, "CFGregorianDateGetAbsoluteTime");
+    const char *desc = (const char *)ocerz_g2h(br_int_arg(cpu, 2));
+    uint64_t out = br_int_arg(cpu, 1);
+    if (!to_abs || !desc || !out)
+        return br_answer(vm, cpu, 0);
+    BrGregorianDate g = { 2001, 1, 1, 0, 0, 0 };
+    int k = 3;
+    for (const char *c = desc; *c; c++) {
+        int32_t v = (int32_t)br_int_arg(cpu, k++);
+        if (*c == 'y') g.year = v; else if (*c == 'M') g.month = (int8_t)v; else if (*c == 'd') g.day = (int8_t)v;
+        else if (*c == 'H') g.hour = (int8_t)v; else if (*c == 'm') g.minute = (int8_t)v; else if (*c == 's') g.second = v;
+    }
+    double at = to_abs(g, br_calendar_zone(br_int_arg(cpu, 0)));
+    memcpy(ocerz_g2h(out), &at, sizeof at);
+    return br_answer(vm, cpu, 1);
+}
