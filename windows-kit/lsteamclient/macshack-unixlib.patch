+/* MacShack Play (iOS, Madeira's Wine): the engine keeps no unix_path for builtins it does not know and binds them
+ * to a stub table, so MacShack Play loads lsteamclient.so itself and passes the address of its __wine_unix_call_funcs
+ * in MONO_MACSHACK_UNIXLIB_LSTEAMCLIENT (Madeira passes only Steam*, FNA3D_* and MONO_* variables to Windows). Wine's
+ * dispatcher indexes the handle as that table. */
+static void macshack_unixlib_handle(void)
+{
+    char value[32];
+
+    if (GetEnvironmentVariableA( "MONO_MACSHACK_UNIXLIB_LSTEAMCLIENT", value, sizeof(value) ) && value[0])
+        __wine_unixlib_handle = (unixlib_handle_t)strtoull( value, NULL, 16 );
+}
 
